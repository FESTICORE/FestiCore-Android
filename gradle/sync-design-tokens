#!/bin/sh
# DesignSystem의 generated/android/tokens를 ui/designkit으로 가져온다. 규칙: .claude/docs/design-system.md
# 사용: gradle/sync-design-tokens <FestiCore-DesignSystem checkout 경로>
# 원천의 생성물은 커밋된 상태여야 하고, 가져온 커밋 SHA를 ui/designkit/tokens.source-sha에 남긴다.
set -eu
cd "$(dirname "$0")/.."
src="${1:?사용: gradle/sync-design-tokens <FestiCore-DesignSystem 경로>}"
if [ -n "$(git -C "$src" status --porcelain -- generated/android)" ]; then
  echo "원천의 generated/android에 커밋되지 않은 변경이 있습니다: $src" >&2
  exit 1
fi
sha=$(git -C "$src" rev-parse HEAD)
dest=ui/designkit/src/main/kotlin/io/festicore/ui/designkit/tokens
mkdir -p "$dest"
rm -f "$dest"/*.kt
cp "$src"/generated/android/tokens/*.kt "$dest"/
printf '%s\n' "$sha" > ui/designkit/tokens.source-sha
echo "디자인 토큰 동기화: $sha"
