#!/usr/bin/env python3
"""모듈 경계 검사. 정해진 모듈 밖에서 쓰면 안 되는 API를 찾으면 실패한다. (.claude/docs/architecture.md · harness.md)

사용: .claude/scripts/check-boundaries      (verify가 코드 변경이 있을 때 먼저 실행한다)
규칙을 더하려면 RULES에 한 줄 추가하고 해당 문서에 같은 규칙을 적는다.
"""
import fnmatch
import os
import re
import subprocess
import sys

# (이름, 검사할 파일 glob, 허용 경로 glob 목록, 금지 패턴, 안내 문서)
RULES = [
    ("Android 보안 값은 core:datastore만", "**/src/**/*.kt",
     ["core/datastore/**"], r"\bjava\.security\.KeyStore\b|\bandroid\.security\.keystore\b|EncryptedSharedPreferences",
     "SecureStorage를 주입받아 쓴다"),
    ("Android SharedPreferences · DataStore는 core:datastore만", "**/src/**/*.kt",
     ["core/datastore/**"], r"getSharedPreferences\(|\bandroidx\.datastore\b|PreferenceManager",
     "설정값은 core:datastore의 저장소를 주입받아 쓴다"),
    ("Android DB(Room)는 core:database만", "**/src/**/*.kt",
     ["core/database/**"], r"\bandroidx\.room\b",
     "DB 접근은 core:database의 DAO를 주입받아 쓴다"),
    ("색은 디자인 토큰만 쓴다", "**/src/**/*.kt",
     ["ui/designkit/src/main/kotlin/io/festicore/ui/designkit/tokens/**", "**/src/test/**", "**/src/androidTest/**"],
     r"\bColor\(\s*0[xX][0-9A-Fa-f]",
     "FestiCoreSemanticColor(ui/designkit 생성 토큰)를 쓴다. 새 색은 FestiCore-DesignSystem 토큰에 추가한다"),
    ("feature는 다른 모듈의 sources를 의존하지 않는다", "feature/**/build.gradle.kts",
     [], r"projects\.\w+(\.\w+)*\.sources\b|project\(\s*\"[^\"]*:sources\"\s*\)",
     "다른 feature · domain은 interface 모듈만 의존한다. sources는 app이 연결한다"),
    ("service:api는 요청을 보내지 않는다", "service/api/**/*.kt",
     [], r"\bHttpClient\b|\bfestiCore(Request|Exchange)\b|\bimport org\.koin\.",
     "service/api에는 경로 · 인증 정책 · 응답 DTO만 둔다. Ktor 요청 · Koin 등록은 service/apiendpoint에 둔다"),
]


def tracked_files(root):
    out = subprocess.run(["git", "-C", root, "ls-files", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, text=True, check=True).stdout
    return out.splitlines()


def matches(path, pattern):
    # fnmatch의 *는 /도 넘는다. **/를 0개 이상 폴더로 다룬다.
    return fnmatch.fnmatch(path, pattern) or fnmatch.fnmatch(path, pattern.replace("/**/", "/"))


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or "."
    files = tracked_files(root)
    violations = []
    for name, target, allowed, pattern, hint in RULES:
        regex = re.compile(pattern, re.MULTILINE)
        for path in files:
            if not matches(path, target) or any(matches(path, a) for a in allowed):
                continue
            try:
                with open(os.path.join(root, path), encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            lines = text.splitlines()
            for m in regex.finditer(text):
                line = text.count("\n", 0, m.start()) + 1
                if lines[line - 1].lstrip().startswith(("//", "*", "/*")):
                    continue  # 주석은 검사하지 않는다
                violations.append(f"  {path}:{line}  [{name}] → {hint}")
    if violations:
        print("모듈 경계 위반 (.claude/docs/architecture.md):")
        print("\n".join(violations))
        return 1
    print(f"모듈 경계 검사 통과 (규칙 {len(RULES)}개)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
