#!/usr/bin/env python3
"""변경 경로에 맞는 빌드 · 테스트를 실행하고 결과를 증거로 남긴다. (.claude/docs/harness.md 검증 게이트)

사용: .claude/scripts/verify          develop 이후 바뀐 코드에 맞는 단계만 실행
      .claude/scripts/verify --all    모든 단계 실행

- 통과하면 .claude/state/verify.json에 작업 트리 지문과 코드 파일 목록을 남긴다. 커밋 게이트와 종료 확인이 이 기록을 본다.
- 출력은 .claude/state/verify/{단계}.log에 저장한다. 종료 코드를 파이프로 가리지 않는다.
- 같은 단계가 2번 연속 실패하면 세 번째 시도 전에 사용자에게 보고한다.
"""
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hooks"))
import harness_state as hs  # noqa: E402

GRADLE = ["mise", "exec", "--", "./gradlew", "--console=plain"]


def steps_for(files, run_all):
    def touched(*prefixes):
        return run_all or any(f == p or f.startswith(p + "/") for f in files for p in prefixes)

    steps = []  # (이름, 명령, 폴더, 추가 환경 변수)
    # 하네스 훅 · 스크립트가 바뀌면 훅 단위 테스트를 먼저 돌린다
    if touched(".claude/hooks", ".claude/scripts", ".githooks", ".claude/settings.json",
               "gradle/svg-to-vector.py", "gradle/sync-design-tokens"):
        steps.append(("hooks-test", [sys.executable, "-m", "unittest", "discover", "-s", os.path.join(".claude", "hooks", "tests")], ".", {}))
    # 모듈 경계(저장소 API 등)는 빠르니 코드가 바뀌면 항상 본다
    if run_all or files:
        steps.append(("boundaries", [os.path.join(".claude", "scripts", "check-boundaries")], ".", {}))
    has_gradle = os.path.isfile("gradlew")
    # 포맷은 전체를 검사한다(1초 안팎). 빌드보다 먼저 봐서 빨리 실패한다
    if run_all or any(f.endswith((".kt", ".kts")) or f in ("gradle/format", ".editorconfig", ".mise.toml") for f in files):
        if os.path.isfile(os.path.join("gradle", "format")):
            steps.append(("format-kotlin", [os.path.join("gradle", "format"), "--check"], ".", {}))
        else:
            print("· format-kotlin 건너뜀: gradle/format이 아직 없습니다")
    gradle_shared = ("build-logic", "gradle", "settings.gradle.kts", "build.gradle.kts", "gradle.properties", ".mise.toml")
    if touched("app", "feature", "domain", "service", "core", "ui", *gradle_shared):
        if has_gradle:
            # 라이브러리는 testDebugUnitTest, 앱은 flavor가 있어 testStageDebugUnitTest
            steps.append(("android", GRADLE + ["testDebugUnitTest", "testStageDebugUnitTest", ":app:assembleStageDebug"], ".", {}))
        else:
            print("· android 건너뜀: Gradle wrapper가 아직 없습니다")
    return steps


def check_log(name, log):
    """종료 코드 0이어도 실패로 볼 경우. 이유를 돌려준다."""
    if name == "hooks-test" and re.search(r"^Ran 0 tests", log, re.M):
        return "훅 테스트가 0개 실행됐습니다. .claude/hooks/tests를 확인하세요."
    return ""


def main():
    root = hs.repo_root(os.getcwd())
    os.chdir(root)
    hs.install_git_hooks(root)
    run_all = "--all" in sys.argv[1:]
    files = hs.changed_code_files(root)
    state = hs.load(root)
    failures = state.get("failures", {})

    steps = steps_for(files, run_all)
    if not steps:
        print("검증할 코드 변경이 없습니다.")
        hs.save(root, {"passed": True, "fingerprint": hs.fingerprint(root), "code": hs.code_entries(root),
                       "steps": [], "failures": {}})
        return 0

    log_dir = os.path.join(hs.STATE_DIR, "verify")
    os.makedirs(log_dir, exist_ok=True)
    results = []
    for name, cmd, cwd, extra_env in steps:
        log_path = os.path.join(log_dir, f"{name}.log")
        print(f"▶ {name}: {' '.join(cmd)} (로그: {log_path})", flush=True)
        started = time.monotonic()
        with open(log_path, "w", encoding="utf-8") as log_file:
            code = subprocess.run(cmd, cwd=cwd, stdout=log_file, stderr=subprocess.STDOUT,
                                  env=dict(os.environ, **extra_env)).returncode
        seconds = round(time.monotonic() - started)
        with open(log_path, encoding="utf-8", errors="replace") as log_file:
            log = log_file.read()
        reason = f"종료 코드 {code}" if code != 0 else check_log(name, log)
        if reason:
            failures[name] = failures.get(name, 0) + 1
            print(f"✘ {name} 실패 ({seconds}초): {reason}")
            print("  마지막 로그:\n    " + "\n    ".join(log.strip().splitlines()[-15:]))
            if failures[name] >= hs.MAX_FAILURES:
                print(f"\n같은 단계({name})가 {failures[name]}번 연속 실패했습니다. "
                      "세 번째 시도 전에 시도한 내용과 실패 원인을 사용자에게 보고하고 승인을 받으세요.")
            hs.save(root, {"passed": False, "fingerprint": hs.fingerprint(root),
                           "steps": results + [{"name": name, "ok": False, "seconds": seconds, "reason": reason}],
                           "failures": failures})
            return 1
        failures.pop(name, None)
        results.append({"name": name, "ok": True, "seconds": seconds})
        print(f"✔ {name} ({seconds}초)")

    hs.save(root, {"passed": True, "fingerprint": hs.fingerprint(root), "code": hs.code_entries(root),
                   "steps": results, "failures": failures})
    print("검증 통과. 기록: " + hs.VERIFY_FILE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
