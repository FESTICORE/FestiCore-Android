<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ImageView android:id="@+id/widget_heading_image" android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_title_image" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/pretendard_variable" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/pretendard_variable" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/pretendard_variable" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" />
</LinearLayout>
